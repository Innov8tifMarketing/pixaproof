#!/usr/bin/env bash
# Materialise this repo's gitignored credential files from 1Password.
#
#   ./secrets-init            # write any credential file that does not exist yet
#   ./secrets-init --force    # overwrite existing files from their templates
#   ./secrets-init --check    # resolve every op:// reference and report, writing nothing
#
# Every tracked *.tmpl holds op:// references only; the files it generates are gitignored
# and hold resolved plaintext. Laravel needs the resolved form: phpdotenv cannot expand
# op://, and php-fpm / queue workers / production have no `op` binary.
#
# - The output name is the template minus `.tmpl`. The glob and the strip must BOTH say
#   `.tmpl` — a mismatched strip turns this into `op inject -o <template>`, silently
#   overwriting the tracked template with resolved secrets.
# - TEMPLATES holds globs only, never literal filenames, so `nullglob` can drop the
#   patterns a given repo has no files for. A literal name would survive and then fail.
# - Whole-file templates (auth.json, *.pem) must end WITHOUT a newline, or the generated
#   file gains a stray byte: harmless for JSON, fatal for PEM parsers.
# - `op whoami` is not a readiness signal. With 1Password desktop-app integration it
#   reports "not signed in" while `op read` / `op inject` succeed via per-command
#   approval, so this warns rather than refusing to run.
set -euo pipefail
cd "$(dirname "$0")"
shopt -s nullglob

TEMPLATES=(.env*.tmpl *.json.tmpl secrets/*.tmpl)

mode="${1:-}"

if ! command -v op >/dev/null 2>&1; then
  echo "error: 1Password CLI (op) not found on PATH." >&2
  exit 1
fi

if [ ${#TEMPLATES[@]} -eq 0 ]; then
  echo "error: no *.tmpl templates found in $(pwd)." >&2
  exit 1
fi

if ! op whoami >/dev/null 2>&1; then
  echo "note: no active op CLI session — relying on desktop-app integration."
  echo "      If the operations below fail, run: eval \$(op signin)"
  echo
fi

if [ "$mode" = "--check" ]; then
  failed=0
  # `op inject -f` deletes its output path before writing, so /dev/null cannot be the
  # target. Render to a private temp file instead and shred it immediately: it holds
  # resolved secrets for the lifetime of the check. mktemp creates it 0600.
  probe=$(mktemp)
  trap 'rm -f "$probe"' EXIT INT TERM
  for tmpl in "${TEMPLATES[@]}"; do
    # Per-reference detail, for diagnosing which field is at fault.
    while IFS= read -r ref; do
      if op read "$ref" >/dev/null 2>&1; then
        printf '  ok      %s\n' "$ref"
      else
        printf '  MISSING %s\n' "$ref"
      fi
    done < <(grep -oE 'op://[^[:space:]"'"'"']+' "$tmpl" | sed 's/[.,;:]$//' | sort -u)

    # The authoritative test. `op inject` parses the WHOLE file — comment lines
    # included — and additionally claims `{{ }}` as its own template syntax. Grepping
    # for refs therefore under-reports: a bare `op://vault/item` mentioned in a comment,
    # or a `{{PLACEHOLDER}}`, passes a grep-based check and then aborts the real run.
    # Injecting to /dev/null is the only check that predicts `--force` exactly.
    if err=$(op inject -f -i "$tmpl" -o "$probe" 2>&1); then
      printf '  INJECT OK   %s\n' "$tmpl"
    else
      printf '  INJECT FAIL %s\n              %s\n' "$tmpl" "$(printf '%s' "$err" | tail -1)"
      failed=$((failed + 1))
    fi
  done
  rm -f "$probe"
  echo
  if [ "$failed" -gt 0 ]; then
    echo "$failed template(s) would fail to render. Fix the template, or add the missing"
    echo "field in 1Password. Reminders: never write a bare op:// item reference in a"
    echo "comment, never use {{ }}, and a trailing space inside a ref breaks the file."
    exit 1
  fi
  echo "all templates render and all references resolve."
  exit 0
fi

for tmpl in "${TEMPLATES[@]}"; do
  out="${tmpl%.tmpl}"
  if [ -e "$out" ] && [ "$mode" != "--force" ]; then
    echo "kept existing $out (use --force to regenerate)"
    continue
  fi
  op inject -f -i "$tmpl" -o "$out"
  chmod 600 "$out"
  echo "regenerated $out"
done
